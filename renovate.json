{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "customManagers:dockerfileVersions"
  ],

  "forkProcessing": "enabled",

  "rebaseWhen": "conflicted",

  "prHourlyLimit": 0,

  "platformAutomerge": false,

  "customManagers": [
    {
      "customType": "regex",
      "description": "Track stable Chunkah container releases",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "CHUNKAH_IMAGE:\\s+\"?quay\\.io/coreos/chunkah:(?<currentValue>v\\d+\\.\\d+\\.\\d+)\"?"
      ],
      "depNameTemplate": "quay.io/coreos/chunkah",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "Track the cosign CLI version pinned for signing, independent of the cosign-installer action version",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "cosign-release:\\s*\"?(?<currentValue>v\\d+\\.\\d+\\.\\d+)\"?"
      ],
      "depNameTemplate": "sigstore/cosign",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    }
  ],

  "packageRules": [
    {
      "description": "Automerge every Renovate update once the PR build is green. The PR build compiles all three flavors (base/kde/xfce) from the Containerfile, so a broken bump fails here rather than reaching main. Note it does not boot-test the image, and it skips the rechunk/push/sign steps (those are gated to non-PR events) -- a change that builds but breaks first boot or `bootc upgrade` would still merge. Failures surface as a red build on main via GitHub notifications.",
      "automerge": true,
      "automergeStrategy": "squash",
      "matchUpdateTypes": ["digest", "pin", "pinDigest", "patch", "minor", "major"]
    },
    {
      "enabled": false,
      "matchUpdateTypes": ["digest", "pinDigest", "pin"],
      "matchPackageNames": ["quay.io/coreos/chunkah"]
    }
  ]
}
