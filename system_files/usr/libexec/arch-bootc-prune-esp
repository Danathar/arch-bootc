#!/usr/bin/env bash
set -euo pipefail

# Remove bootc kernel/initramfs directories from the EFI System Partition (ESP)
# when they are no longer referenced by any BLS entry.
#
# bootc writes kernel/initramfs artifacts from the image into the ESP, while
# active deployments are referenced by /loader/entries/*.conf.  If an upgrade
# is interrupted or cleanup misses old artifacts, a small ESP can fill up and
# make future upgrades fail while writing BLS/initrd files.
#
# A deployment that is staged but not yet finalized is referenced from
# /loader/entries.staged/*.conf instead: the composefs backend writes its new
# kernel/initrd into /EFI/Linux/<id>/ at `bootc upgrade`/`bootc switch` time
# and only moves the staged entries into loader/entries at shutdown. Both
# directories are read below, or the kernel the next boot needs is deleted in
# the window between staging and reboot.
#
# Reading those directories is not what keeps a staged kernel safe, though,
# because where bootc keeps staged entries is its own detail and can move in
# any bootc release. Before pruning anything the script asks bootc itself
# (`bootc status`, see bootc_allows_prune below) and prunes nothing while a
# deployment is staged, or when bootc cannot be asked or answers with
# something that is not a status document. loader/entries.staged stays in the
# keep-set as a second layer behind that check.

usage() {
  cat <<'USAGE'
Usage: arch-bootc-prune-esp [--dry-run]

Prunes unreferenced /EFI/Linux/<deployment>/ directories from mounted ESPs.
Set BOOTC_PRUNE_ESP_PATH=/path/to/esp to target a specific ESP.
USAGE
}

dry_run=0
case "${1:-}" in
  --dry-run) dry_run=1 ;;
  -h|--help) usage; exit 0 ;;
  "") ;;
  *) usage >&2; exit 2 ;;
esac

log() {
  printf '%s\n' "$*"
}

# GPT partition type GUID for an EFI System Partition. This is the same
# constant bootc itself uses to find the ESP (see `ESP` in
# crates/blockdev/src/blockdev.rs and
# crates/lib/src/discoverable_partition_specification.rs upstream at
# https://github.com/bootc-dev/bootc), so anything discovered here is held
# to the same bar bootc itself uses.
ESP_PARTTYPE_GUID="c12a7328-f81f-11d2-ba4b-00a0c93ec93b"

# Return success only if $1 is the mountpoint of a real, non-removable EFI
# System Partition: an actual vfat filesystem, backed by a real block device
# (not a bind mount, loop device, or overlay), whose GPT partition type is
# the ESP GUID, and whose device is not flagged removable/hotplug.
#
# This exists because falling back to "any mounted vfat filesystem that has
# EFI/Linux and loader/entries" can match a plugged-in bootable USB stick
# (systemd-boot rescue media, Ventoy, etc.) just as easily as the real ESP.
# Every candidate mountpoint, including the well-known static ones, is
# required to pass this check before prune_esp() is allowed to touch it.
#
# Fails closed: any missing tool, unexpected shape, or lookup error is
# treated as "not a genuine ESP" rather than as "assume it is fine".
is_genuine_esp() {
  local mnt="$1" mnt_info source fstype dev_info parttype removable hotplug
  [[ -n "$mnt" ]] || return 1

  command -v findmnt >/dev/null 2>&1 || return 1
  command -v lsblk >/dev/null 2>&1 || return 1

  # An idle systemd automount (autofs) sits on the mountpoint until something
  # touches it, and findmnt would then describe only the autofs layer. Touch a
  # path below it first so the real filesystem is mounted before we look. A
  # failure here is fine: the checks below still decide, and they fail closed.
  stat -- "$mnt/EFI" >/dev/null 2>&1 || true

  mnt_info=$(findmnt -Pno SOURCE,FSTYPE "--mountpoint=$mnt" 2>/dev/null) || return 1
  # Once the automount fired, the mountpoint holds a stack (autofs, then the
  # real filesystem) and findmnt prints one line per layer, bottom first. Only
  # the top of the stack is what the system actually reads and writes, so judge
  # that line alone; every check below still applies to it.
  mnt_info="${mnt_info##*$'\n'}"
  [[ "$mnt_info" =~ SOURCE=\"([^\"]*)\" ]] || return 1
  source="${BASH_REMATCH[1]}"
  [[ "$mnt_info" =~ FSTYPE=\"([^\"]*)\" ]] || return 1
  fstype="${BASH_REMATCH[1]}"

  [[ "$fstype" == "vfat" ]] || return 1
  # Must be a real block device node, not a loop/bind/overlay source like
  # "tmpfs[/...]" or a path with no backing device at all.
  [[ -n "$source" && -b "$source" ]] || return 1

  dev_info=$(lsblk -dPno PARTTYPE,RM,HOTPLUG -- "$source" 2>/dev/null) || return 1
  [[ "$dev_info" =~ PARTTYPE=\"([^\"]*)\" ]] || return 1
  parttype="${BASH_REMATCH[1],,}"
  [[ "$dev_info" =~ RM=\"([^\"]*)\" ]] || return 1
  removable="${BASH_REMATCH[1]}"
  [[ "$dev_info" =~ HOTPLUG=\"([^\"]*)\" ]] || return 1
  hotplug="${BASH_REMATCH[1]}"

  [[ "$parttype" == "$ESP_PARTTYPE_GUID" ]] || return 1
  [[ "$removable" == "0" ]] || return 1
  [[ "$hotplug" == "0" ]] || return 1
}

add_candidate() {
  local esp="$1"
  [[ -n "$esp" ]] || return 0
  [[ -d "$esp/EFI/Linux" && -d "$esp/loader/entries" ]] || return 0
  printf '%s\n' "$esp"
}

find_esps() {
  if [[ -n "${BOOTC_PRUNE_ESP_PATH:-}" ]]; then
    # Explicit escape hatch: always honored, no ESP-genuineness check.
    add_candidate "$BOOTC_PRUNE_ESP_PATH"
    return 0
  fi

  local target
  while IFS= read -r target; do
    is_genuine_esp "$target" && add_candidate "$target"
  done < <(
    {
      # Common bootc/systemd-boot mount points first.
      printf '%s\n' /boot/efi /boot /efi
      # Then any other mounted vfat filesystem that looks like an ESP.
      # `|| true` keeps a legitimate "no vfat filesystems found" result
      # (findmnt exit 1) from tripping `set -e -o pipefail` and aborting
      # the rest of this function.
      if command -v findmnt >/dev/null 2>&1; then
        findmnt -rn -t vfat -o TARGET 2>/dev/null || true
      fi
    } | sort -u
  )
}

# Add every /EFI/Linux/<id>/ directory the given BLS entries reference to
# prune_esp()'s keep-set (bash dynamic scope: `keep` and `esp` are its locals).
collect_references() {
  local entry key path rest rel dir

  for entry in "$@"; do
    while read -r key path rest || [[ -n "${key:-}" ]]; do
      # BLS entries use absolute ESP-relative paths like:
      #   linux /EFI/Linux/<id>/vmlinuz
      #   initrd /EFI/Linux/<id>/initrd
      case "$key" in
        linux|initrd)
          path="${path%$'\r'}"
          if [[ "$path" == /EFI/Linux/*/* ]]; then
            rel="${path#/}"
            dir="${rel%/*}"
            keep["$esp/$dir"]=1
          fi
          ;;
      esac
    done < "$entry"
  done
}

prune_esp() {
  local esp="$1"
  declare -A keep=()
  local candidate

  shopt -s nullglob

  # The guard counts finalized entries only. They are what the running system
  # and its rollback boot from, so an ESP where none can be read is one this
  # script does not understand, and it must not delete anything there. A
  # staged entry alone does not pass the guard: pruning on it would keep only
  # the not-yet-booted deployment and delete the booted one.
  collect_references "$esp"/loader/entries/*.conf

  if (( ${#keep[@]} == 0 )); then
    log "arch-bootc-prune-esp: $esp: no referenced bootc EFI artifacts found; refusing to prune"
    return 0
  fi

  collect_references "$esp"/loader/entries.staged/*.conf

  for candidate in "$esp"/EFI/Linux/*; do
    [[ -d "$candidate" ]] || continue
    if [[ -n "${keep[$candidate]+x}" ]]; then
      log "arch-bootc-prune-esp: keeping ${candidate#"$esp"/}"
      continue
    fi

    if (( dry_run )); then
      log "arch-bootc-prune-esp: would prune ${candidate#"$esp"/}"
    else
      log "arch-bootc-prune-esp: pruning ${candidate#"$esp"/}"
      rm -rf --one-file-system -- "$candidate"
    fi
  done
}

# Succeed only when bootc reports, in a status document this script can read,
# that no deployment is staged. A staged deployment's kernel sits in
# EFI/Linux/<id>/ from `bootc upgrade` until the reboot, and nothing outside
# bootc says for certain where its entry is kept, so while one is staged the
# script prunes nothing at all. Fails closed: no bootc or jq, a bootc that
# fails, and output with no .status object all count as "cannot tell", which
# skips one cleanup run and costs nothing else.
bootc_allows_prune() {
  local status_json staged

  if ! command -v bootc >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
    log "arch-bootc-prune-esp: bootc status cannot be run here; refusing to prune"
    return 1
  fi
  if ! status_json="$(bootc status --format=json --format-version=1 2>/dev/null)"; then
    log "arch-bootc-prune-esp: bootc status failed; refusing to prune"
    return 1
  fi
  staged="$(jq -r '.status
    | if type == "object" then (.staged != null)
      else error("not a bootc status document") end' <<<"$status_json" 2>/dev/null)" || staged=""

  case "$staged" in
    false)
      return 0
      ;;
    true)
      log "arch-bootc-prune-esp: bootc reports a staged deployment; refusing to prune until it is booted"
      return 1
      ;;
    *)
      log "arch-bootc-prune-esp: bootc status output has no status object; refusing to prune"
      return 1
      ;;
  esac
}

mapfile -t esps < <(find_esps | sort -u)

if (( ${#esps[@]} == 0 )); then
  log "arch-bootc-prune-esp: no mounted ESP with EFI/Linux and loader/entries found"
  exit 0
fi

bootc_allows_prune || exit 0

for esp in "${esps[@]}"; do
  prune_esp "$esp"
done
