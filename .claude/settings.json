      "Bash(virsh *)",
      "Bash(losetup*)",
      "Bash(virsh -c qemu:///system *)",
      "Bash(virsh --connect qemu:///system *)",
      "Bash(git checkout --*)",
      "Bash(git restore*)",
      "Bash(git switch*)",
      "Bash(git checkout*)",
      "Bash(git branch*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git rebase*)",
      "Bash(git cherry-pick*)",
      "Bash(gh pr create*)",
